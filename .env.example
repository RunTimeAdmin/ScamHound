# ===== API Keys (Required) =====
BAGS_API_KEY=your_bags_api_key
HELIUS_API_KEY=your_helius_api_key
BIRDEYE_API_KEY=your_birdeye_api_key
BUBBLEMAPS_API_KEY=your_bubblemaps_api_key

# ===== LLM Provider Configuration =====
# Options: "anthropic" or "deepseek" (default: "anthropic")
LLM_PROVIDER=deepseek
# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Required if LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional DeepSeek model override (default: "deepseek-chat")
DEEPSEEK_MODEL=deepseek-chat

# ===== Scanning Configuration =====
# Enable/disable automatic background scanning (default: "false")
# When false, only manual scans via dashboard work
AUTO_SCAN_ENABLED=false
# Seconds between auto-scan cycles (default: 60)
POLL_INTERVAL_SECONDS=60
# Minimum token age in minutes before scoring (default: 0)
MIN_TOKEN_AGE_MINUTES=0

# ===== Platform Configuration =====
# Enable/disable token feed platforms
ENABLE_BAGS=true
ENABLE_PUMPFUN=false
ENABLE_LETSBONK=false
ENABLE_MOONSHOT=false

# ===== Dashboard & Server =====
PORT=8000
DB_PATH=scamhound.db

# ===== Security =====
# Admin token for settings page access
SCAMHOUND_ADMIN_TOKEN=your_strong_secret_token

# ===== Alerts Configuration =====
RISK_ALERT_THRESHOLD=65
TWITTER_BEARER_TOKEN=your_twitter_bearer
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
